{
  "name": "baton",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "vitest run",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "pnpm -r typecheck",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "report": "pnpm --filter @baton/core build && pnpm --filter @baton/core report",
    "coverage": "vitest run --coverage --coverage.include=packages/core/src/**",
    "baton": "node packages/daemon/dist/index.js"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@types/node": "^20.19.0",
    "@vitest/coverage-v8": "^4.1.12",
    "typescript": "~5.9.3",
    "vitest": "^4.1.12"
  }
}
