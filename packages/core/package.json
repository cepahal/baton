{
  "name": "@baton/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "BatonEvent types and transcript parser. Pure: no I/O.",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "report": "node scripts/reduction-report.mjs"
  },
  "dependencies": {
    "zod": "^4.6.7"
  }
}
