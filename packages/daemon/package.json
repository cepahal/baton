{
  "name": "@baton/daemon",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Watches Claude Code transcripts and serves BatonEvents on localhost. Owns all I/O.",
  "bin": {
    "baton": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js start"
  },
  "dependencies": {
    "@baton/core": "workspace:*",
    "@fastify/static": "^10.1.8",
    "@fastify/websocket": "^11.3.6",
    "chokidar": "^5.0.0",
    "fastify": "^5.12.7",
    "pino": "^10.4.0",
    "ws": "^8.22.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/ws": "^8.18.2"
  }
}
